# Supabase browser-safe configuration.
# Get these from Supabase Dashboard -> Connect / Settings -> API Keys.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxx"

# Optional: only used by server-side workers, never expose in Vite/browser code.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxx"
